// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  // fields
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  image    String?

  platformRole PlatformRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isActive Boolean @default(true)

  // relations
  workspaces    WorkspaceMember[]
  //tasks has two relation with user
  assignedTasks Task[]            @relation("AssignedTasks") //1. task assigned to 
  createdTasks  Task[]            @relation("CreatedTasks") //2. who created it 
  comments      Comment[]
  invitations   Invitation[]
  messages      Message[]
}

model Workspace {
  // fields
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // relations
  members     WorkspaceMember[]
  projects    Project[]
  invitations Invitation[]
  messages    Message[]
}

// join/association model - links worspace and user model
model WorkspaceMember {
  // fields
  id       String        @id @default(cuid())
  role     WorkspaceRole @default(MEMBER)
  joinedAt DateTime      @default(now())

  userId      String
  workspaceId String

  //relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // constraints
  @@unique([userId, workspaceId]) // prevents the same user added to the same workspace twice
  @@index([workspaceId])
  @@index([userId])
}

// Workspace Owner inviting other member in workspace

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

model Invitation {
  // fields
  id          String   @id @default(cuid())
  email       String
  token       String   @unique
  workspaceId String
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  status InvitationStatus @default(PENDING)

  // relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  // constraints
  @@index([workspaceId])
  @@index([email])
}

model Project {
  // fields
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // relations
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]

  // constraints
  @@index([workspaceId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// Tasks  - 1. belongs to User
//          2. assigned to User 
//          3. created by User
//          4. has many comments

model Task {
  // fields
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Restrict)

  comments Comment[]

  // constraints
  @@index([projectId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
}

// task  - many comments
// every comments has one author
model Comment {
  // fields
  id      String @id @default(cuid())
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict) //delete user but comment stays

  // constraints
  @@index([taskId])
  @@index([authorId])
}

model Message {
  id          String   @id @default(cuid())
  content     String
  workspaceId String
  senderId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([senderId])
  @@index([createdAt])
}
